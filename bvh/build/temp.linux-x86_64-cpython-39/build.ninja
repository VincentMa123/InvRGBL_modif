ninja_required_version = 1.3
cxx = c++
nvcc = /lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/bin/nvcc

cflags = -pthread -B /lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/include -fPIC -O2 -isystem /lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/include -fPIC -I/lab/haoq_lab/cse12310504/InvRGBL/bvh/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/lib/python3.9/site-packages/torch/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/lib/python3.9/site-packages/torch/include/TH -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/lib/python3.9/site-packages/torch/include/THC -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/include/python3.9 -c
post_cflags = -O3 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/lab/haoq_lab/cse12310504/InvRGBL/bvh/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/lib/python3.9/site-packages/torch/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/lib/python3.9/site-packages/torch/include/TH -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/lib/python3.9/site-packages/torch/include/THC -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/include -I/lab/haoq_lab/cse12310504/.conda/envs/InvRGBL/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 --expt-extended-lambda -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_75,code=sm_75 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /lab/haoq_lab/cse12310504/InvRGBL/bvh/build/temp.linux-x86_64-cpython-39/lab/haoq_lab/cse12310504/InvRGBL/bvh/src/bindings.o: compile /lab/haoq_lab/cse12310504/InvRGBL/bvh/src/bindings.cpp
build /lab/haoq_lab/cse12310504/InvRGBL/bvh/build/temp.linux-x86_64-cpython-39/lab/haoq_lab/cse12310504/InvRGBL/bvh/src/bvh.o: cuda_compile /lab/haoq_lab/cse12310504/InvRGBL/bvh/src/bvh.cu
build /lab/haoq_lab/cse12310504/InvRGBL/bvh/build/temp.linux-x86_64-cpython-39/lab/haoq_lab/cse12310504/InvRGBL/bvh/src/construct.o: cuda_compile /lab/haoq_lab/cse12310504/InvRGBL/bvh/src/construct.cu
build /lab/haoq_lab/cse12310504/InvRGBL/bvh/build/temp.linux-x86_64-cpython-39/lab/haoq_lab/cse12310504/InvRGBL/bvh/src/trace.o: cuda_compile /lab/haoq_lab/cse12310504/InvRGBL/bvh/src/trace.cu







